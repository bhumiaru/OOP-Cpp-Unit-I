#include <iostream>          // Includes the input/output stream library
using namespace std;         // Allows us to use cout and endl without std::

class Test                  // Defines a class named Test
{
private:
    int value;               // Private data member to store an integer value

public:

    // Constructor of the Test class
    Test(int v)
    {
        value = v;           // Assigns the value of v to the data member value
    }

    // Inline member function
    inline int getValue()
    {
        return value;        // Returns the value stored in the private variable
    }

    // Friend function declaration
    friend void show(Test t);
    // Allows the function show() to access private members of Test
};


// Definition of the friend function
void show(Test t)
{
    cout << t.value;         // Accesses and displays the private variable value
}


// Main function: program execution starts here
int main()
{
    Test obj(50);             // Creates an object 'obj' and passes 50 to the constructor

    cout << obj.getValue()    // Calls getValue() and displays the returned value
         << endl;             // Moves the cursor to the next line

    show(obj);                // Calls the friend function and passes obj as an argument

    return 0;                 // Indicates successful termination of the program
}
