#include <iostream>              // #include = includes a library
                                  // <iostream> = input/output stream library
                                  // Used for cout and endl

using namespace std;             // using = allows us to use
                                  // namespace = group of names
                                  // std = standard C++ namespace


class Test                        // class = keyword used to create a class
                                  // Test = name of the class
{
private:                          // private = accessible only inside the class

    int value;                    // int = integer data type
                                  // value = name of private variable


public:                           // public = accessible from outside the class


    Test(int v)                   // Test = constructor name
                                  // int = integer data type
                                  // v = parameter
    {
        value = v;                // value = class variable
                                  // = = assignment operator
                                  // v = parameter value
    }


    inline int getValue()         // inline = inline function
                                  // int = return type
                                  // getValue = function name
                                  // () = no parameter
    {
        return value;             // return = sends value back
                                  // value = private variable
    }


    friend void show(Test t);     // friend = gives show() access to private members
                                  // void = function returns nothing
                                  // show = function name
                                  // Test = class type
                                  // t = object parameter
};


// Definition of friend function
void show(Test t)                 // void = function returns nothing
                                  // show = function name
                                  // Test = parameter data type
                                  // t = parameter/object name
{
    cout << "Amit " << t.value;   // cout = displays output
                                  // << = insertion/output operator
                                  // "Amit " = displays the word Amit
                                  // t = object passed to the function
                                  // . = member access operator
                                  // value = private variable
                                  // Friend function can access private value
}


int main()                        // int = return type
                                  // main = starting point of program
                                  // () = no parameters
{
    Test obj(101);                // Test = class name
                                  // obj = object name
                                  // 101 = value passed to constructor
                                  // Constructor stores 101 in value


    show(obj);                    // show = calls friend function
                                  // obj = object passed to show()
                                  // show() accesses private value


    return 0;                     // return = ends the program
                                  // 0 = successful program execution
}
